{
  "name": "logscope",
  "version": "1.0.0",
  "description": "Standalone log analysis tool — Drain-style log parsing, Sentry-style issue grouping, and anomaly detection",
  "type": "module",
  "license": "MIT",
  "bin": {
    "logscope": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
