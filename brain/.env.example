# AI Brain — copy to .env and fill in. Never commit real keys.
BRAIN_DEFAULT_PROVIDER=mock
BRAIN_MAX_STEPS=12
BRAIN_MAX_TOKENS_PER_CALL=2000
BRAIN_TOKEN_BUDGET=32000
BRAIN_COST_BUDGET_USD=0.5
BRAIN_REQUEST_TIMEOUT_MS=30000
BRAIN_MAX_RETRIES=2
BRAIN_MEMORY_TOPK=6
BRAIN_ENABLE_SECURITY=true
BRAIN_ENABLE_EVAL=true
BRAIN_LOG_LEVEL=info

# Real providers (optional — Brain works offline with mock provider):
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1  # override for DeepSeek/Qwen/Mistral-compatible endpoints
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
WEB_SEARCH_API_KEY=
